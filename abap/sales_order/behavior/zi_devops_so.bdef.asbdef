managed implementation in class zbp_i_devops_so unique;
strict ( 2 );
with draft;

define behavior for ZI_DEVOPS_SO
persistent table zdevops_so
draft table zdevops_so_d
lock master
total etag local_last_changed_at
authorization master ( global )
etag master local_last_changed_at

{
  create;
  update;
  delete;

 field ( readonly, numbering : managed ) sales_order_id;

  draft action Edit;
  draft action Resume;
  draft action Activate optimized;
  draft action Discard;
  validation validate_amount on save { create; update; field amount; }
  draft determine action Prepare
  {
    validation validate_amount;
  }
}